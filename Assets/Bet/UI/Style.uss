:root {
}

.h1 {
    color: rgb(255, 255, 255);
    font-size: 45px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=14d80294f14a3884387d346d008a174c&type=3#NotInter-Regular");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.windowButton {
    flex-grow: 1;
    flex-basis: 0%;
    scale: 1 1;
    border-right-color: rgba(0, 0, 0, 0);
    -unity-slice-type: sliced;
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
    min-width: auto;
    min-height: auto;
    max-width: none;
    max-height: none;
    aspect-ratio: 1;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-left-radius: 37px;
    border-top-right-radius: 37px;
    border-bottom-right-radius: 37px;
    border-bottom-left-radius: 37px;
    filter: none();
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
    opacity: 1;
    font-size: 0;
    border-top-width: -9px;
    border-right-width: -9px;
    border-bottom-width: -9px;
    border-left-width: -9px;
    -unity-text-auto-size: none;
}

.tabButton {
    background-color: rgba(255, 255, 255, 0);
    font-size: 25px;
    color: rgb(255, 255, 255);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    height: 100%;
}

.matchListItem {
    flex-shrink: 0;
}

.customScroll {
}







.unity-scroll-view__content-container--vertical {
    flex-direction: row;
    flex-wrap: wrap;
}


