<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="" class="card" style="flex-grow: 0; flex-shrink: 0; align-items: auto; justify-content: flex-end; flex-direction: column; visibility: visible; display: flex; margin-top: 28px; margin-right: 28px; margin-bottom: 28px; margin-left: 28px; height: 221px; width: 495px; background-color: rgb(20, 26, 45); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;">
        <ui:VisualElement style="flex-grow: 0; width: 100%; height: 61%; flex-direction: column; padding-top: 7px; padding-right: 7px; padding-bottom: 7px; padding-left: 7px; flex-shrink: 0; align-items: center;">
            <ui:Label text="Brazil x Croatia" name="Team" class="card-h1" style="-unity-text-auto-size: none; -unity-text-generator: advanced; flex-grow: 0; -unity-text-align: middle-center; font-size: 42px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; align-content: center; align-items: center; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
            <ui:VisualElement name="" style="flex-grow: 1; height: 100%; width: 174px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-generator: advanced; -unity-text-auto-size: best-fit 10px 100px; display: flex; -unity-text-align: middle-left;">
                <ui:Label text="Win (Brasil)" name="Type" class="card-h1" style="color: rgb(255, 255, 255); -unity-font-style: bold; height: 49px; -unity-text-align: middle-center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-auto-size: none; font-size: 33px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 0; flex-direction: row;">
            <ui:Label text="In Progress" name="State" style="-unity-text-auto-size: best-fit 10px 100px; -unity-text-generator: advanced; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
            <ui:Label text="$200.00&#10;&lt;color=green&gt;1.25x" name="Info" style="color: rgb(255, 255, 255); justify-content: flex-start; align-items: center; -unity-text-align: middle-right; flex-grow: 1; -unity-font-style: bold; -unity-text-auto-size: best-fit 10px 100px; -unity-text-generator: advanced;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
